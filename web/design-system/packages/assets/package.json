{
  "name": "@kaggle-environments/design-system-assets",
  "version": "0.0.0",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts"
      }
    }
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "packed",
    "src",
    "families.json"
  ],
  "scripts": {
    "build": "node ./scripts/build-assets.mjs && tsc -b && vite build",
    "build:assets": "node ./scripts/build-assets.mjs",
    "check:roster": "node ./scripts/build-assets.mjs --check",
    "dev:watch": "tsc --build --watch"
  },
  "devDependencies": {
    "@assetpack/core": "^1.7.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^4.5.4"
  }
}
